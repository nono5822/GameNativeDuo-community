{
  "$schema": "../../../schema/package.schema.json",
  "format": "gamenative-duo/package",
  "version": 1,
  "id": "gamenative-duo.hollow-knight-dual-screen",
  "kind": "mod",
  "packageVersion": "0.4.0",
  "game": {
    "store": "steam",
    "appId": "367520",
    "title": "Hollow Knight"
  },
  "requires": {
    "adapter": "unity-ugui>=0.3",
    "app": ">=0.3"
  },
  "title": "Dual screen (experimental)",
  "description": "The world on the top screen; the HUD (masks, soul, geo), inventory, map and menus on the bottom screen, which you can rearrange in game, plus the live map. Built from source by CI.",
  "authors": [
    "GameNative Duo"
  ],
  "license": "MIT",
  "tags": [
    "experimental"
  ],
  "changelog": [
    {
      "version": "0.4.0",
      "date": "2026-11-08",
      "notes": "The Hollow Knight plugin (live map on the bottom screen) is built from source by the community CI and signed by its author."
    }
  ],
  "files": [
    {
      "path": "README.txt",
      "sha256": "31e2487243761c8342e53328e5cd294626afe26f035276a8649d51b6954bc091"
    }
  ],
  "build": {
    "engine": "dotnet",
    "source": {
      "repo": "https://github.com/nono5822/GameNativeDuo",
      "commit": "cc6ea25fe9476666d4d659ad6c8deacf02e63471"
    },
    "project": "duo/mods-src/unity/GameNativeDuo.HollowKnight/GameNativeDuo.HollowKnight.csproj",
    "refs": [
      "hollow-knight-1.5.12620",
      "bepinex-5.4.23.5"
    ],
    "properties": {
      "ManagedPath": "{refs:hollow-knight-1.5.12620}",
      "BepInExPath": "{refs:bepinex-5.4.23.5}"
    },
    "outputs": {
      "duo/mods-src/unity/GameNativeDuo.HollowKnight/bin/Release/net46/GameNativeDuo.HollowKnight.dll": "plugin/GameNativeDuo.HollowKnight.dll"
    }
  },
  "install": {
    "sharedAssets": {
      "bepinex": "",
      "BepInEx-LICENSE.txt": "BepInEx/LICENSE-BepInEx.txt",
      "BepInEx-NOTICE.txt": "BepInEx/NOTICE-GameNativeDuo.txt",
      "unity-split": "BepInEx/plugins/GameNativeDuo-split"
    },
    "gameFiles": {
      "README.txt": "BepInEx/plugins/GameNativeDuo-split/README.txt",
      "plugin/GameNativeDuo.HollowKnight.dll": "BepInEx/plugins/GameNativeDuo-hollowknight/GameNativeDuo.HollowKnight.dll"
    },
    "dllOverrides": [
      "winhttp=n,b"
    ],
    "splitLayout": "native"
  },
  "bridge": {
    "capabilities": [
      "touch",
      "ui-rules",
      "elements",
      "background-basic",
      "state"
    ]
  }
}
