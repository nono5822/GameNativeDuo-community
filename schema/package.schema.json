{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nono5822.github.io/GameNativeDuo-community/schema/package.schema.json",
  "title": "GameNative Duo community package manifest",
  "description": "games/<store>-<appId>/<id>/manifest.json (devices/<id>/manifest.json for device profiles). One package = one layout, settings file, device profile or mod.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "kind",
    "packageVersion",
    "title",
    "description",
    "authors",
    "license",
    "files"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "gamenative-duo/package"
    },
    "version": {
      "const": 1
    },
    "id": {
      "description": "Unique package id, <author>.<name>, lower case. Must equal the package folder's name.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,38}\\.[a-z0-9][a-z0-9-]{0,62}$"
    },
    "kind": {
      "enum": [
        "ui-layout",
        "duo-settings",
        "device-profile",
        "mod",
        "game-profile"
      ]
    },
    "packageVersion": {
      "description": "Semantic version of this package.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store",
        "appId",
        "title"
      ],
      "properties": {
        "store": {
          "enum": [
            "steam",
            "epic",
            "gog",
            "amazon"
          ]
        },
        "appId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "builds": {
          "description": "Game versions this package was made and tested with (as the game shows them). Empty: any.",
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "description": "Engine adapter and minimum version, e.g. unity-ugui>=0.2 (the engine name the mod sends in its bridge HELLO).",
          "type": "string",
          "pattern": "^[a-z0-9-]+(>=[0-9]+(\\.[0-9]+){0,2})?$"
        },
        "app": {
          "description": "Minimum GameNative Duo version, e.g. >=0.3",
          "type": "string",
          "pattern": "^>=[0-9]+(\\.[0-9]+){0,2}$"
        }
      }
    },
    "testedOn": {
      "description": "Device profile ids it was tested on (e.g. ayn-thor).",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,40}$"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      }
    },
    "githubLogins": {
      "description": "GitHub accounts of the package's authors. Their own 👍/👎 on the package's discussion are not counted. The share bot fills it with the sharing account.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]{1,39}$"
      }
    },
    "changelog": {
      "description": "What changed, newest first. The app shows the newest five.",
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "notes"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "license": {
      "description": "SPDX licence id of this package's content, e.g. CC0-1.0, MIT.",
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]{2,40}$"
    },
    "tags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,24}$"
      }
    },
    "screenshots": {
      "description": "Paths of images in the package folder, top and bottom screen. Shown on the package card.",
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/relPath"
      }
    },
    "files": {
      "description": "Every file the package installs. Local files sit in the package folder; large data files may instead be a GitHub Release asset of this repo (url). Code is never a file here: a mod's binaries come from its build (CI), and the only binaries allowed are pinned loader files (loaders.json).",
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/relPath"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/nono5822/GameNativeDuo-community/releases/download/"
          }
        }
      }
    },
    "install": {
      "description": "mod only: where files go. Keys are entries of files[].path; values are paths relative to the game folder (gameFiles) or the Wine prefix's drive_c (prefixFiles).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gameFiles": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/relPath"
          },
          "additionalProperties": {
            "$ref": "#/$defs/relPathOrEmpty"
          }
        },
        "prefixFiles": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/relPath"
          },
          "additionalProperties": {
            "$ref": "#/$defs/relPath"
          }
        },
        "dllOverrides": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+=(n|b|n,b|b,n|)$"
          }
        },
        "sharedAssets": {
          "description": "Copies of files the app already ships (no download), to paths in the game folder. Known: bepinex, unity-split, BepInEx-LICENSE.txt, BepInEx-NOTICE.txt.",
          "type": "object",
          "propertyNames": {
            "enum": [
              "bepinex",
              "unity-split",
              "BepInEx-LICENSE.txt",
              "BepInEx-NOTICE.txt"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/relPathOrEmpty"
          }
        },
        "launchExecutable": {
          "description": "Executable to start instead of the game's own, relative to the game folder (e.g. a mod loader).",
          "$ref": "#/$defs/relPath"
        },
        "splitLayout": {
          "description": "How the screen split cuts the tall game window (default native).",
          "enum": [
            "fill",
            "native"
          ]
        }
      }
    },
    "build": {
      "description": "mod only: how CI builds the mod from source. The index lists only CI-built outputs, never binaries from the package.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "outputs"
      ],
      "properties": {
        "engine": {
          "description": "dotnet: dotnet build of project (C#: BepInEx, SMAPI). scripts: no build, the source files are the mod (Lua); outputs name them.",
          "enum": [
            "dotnet",
            "scripts"
          ]
        },
        "source": {
          "description": "Where the source is. Omitted: the package's own src/ folder. Otherwise a public git repository at a full commit hash (a tag or branch could move).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "commit"
          ],
          "properties": {
            "repo": {
              "type": "string",
              "pattern": "^https://(github\\.com|gitlab\\.com|codeberg\\.org)/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "path": {
              "$ref": "#/$defs/relPath"
            }
          }
        },
        "project": {
          "description": "dotnet: the .csproj, relative to the source root.",
          "$ref": "#/$defs/relPath"
        },
        "configuration": {
          "enum": [
            "Release",
            "Debug"
          ],
          "default": "Release"
        },
        "refs": {
          "description": "Reference sets from refs.json (game and engine assemblies as stubs: public API only, no code) the build compiles against.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
          }
        },
        "properties": {
          "description": "MSBuild properties. {refs:<id>} stands for the folder of that reference set, {source} for the source root.",
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^[^;\"`$]*$"
          }
        },
        "outputs": {
          "description": "Build output (relative to the source root) -> the package path install refers to. CI hashes each one into the index.",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 50,
          "propertyNames": {
            "$ref": "#/$defs/relPath"
          },
          "additionalProperties": {
            "$ref": "#/$defs/relPath"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "engine": {
                "const": "dotnet"
              }
            }
          },
          "then": {
            "required": [
              "project"
            ]
          }
        }
      ]
    },
    "author": {
      "description": "The author's signing key (an SSH ed25519 key: duo keygen, or one you have). manifest.json.sig signs this manifest with it (duo pack --sign). The app remembers the key at first install: an update signed by another key asks the user again. Required for mods with a build.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/sshKey"
        },
        "history": {
          "description": "Earlier keys of this package, oldest first. Each handover is that key's SSH signature (namespace gamenative-duo-key-handover) over the next key's line plus a newline: tools/duo_index.py handover.",
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "handover"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/sshKey"
              },
              "handover": {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^-----BEGIN SSH SIGNATURE-----\\n[A-Za-z0-9+/=\\n]+-----END SSH SIGNATURE-----\\n?$"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "relPath": {
      "description": "Forward slashes, relative, no '..', no leading '/'.",
      "type": "string",
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*\\\\)[^:*?\"<>|]+$"
    },
    "relPathOrEmpty": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/relPath"
        }
      ]
    },
    "sshKey": {
      "description": "An OpenSSH ed25519 public key without comment: ssh-ed25519 AAAA...",
      "type": "string",
      "pattern": "^ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI[A-Za-z0-9+/]{43}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "not": {
              "const": "device-profile"
            }
          }
        }
      },
      "then": {
        "required": [
          "game"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "mod"
          }
        }
      },
      "then": {
        "required": [
          "install",
          "requires"
        ]
      },
      "else": {
        "not": {
          "required": [
            "install"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "not": {
              "const": "mod"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "build"
          ]
        }
      }
    }
  ]
}
